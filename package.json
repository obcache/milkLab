{
  "name": "milklab",
  "version": "0.1.1",
  "private": false,
  "description": "IDE for .milk preset development",
  "main": "build/electron/main.cjs",
  "scripts": {
    "dev": "node tools/dev.cjs",
    "dev:web": "vite --host 127.0.0.1",
    "build:projectm": "node tools/build-projectm.cjs",
    "build:electron": "node tools/build-electron.cjs",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "test": "vitest run",
    "test:desktop": "node tools/smoke.cjs",
    "test:startup": "node tools/test-startup.cjs",
    "test:dev": "node tools/test-dev.cjs",
    "package": "node tools/package.cjs",
    "package:installer": "node tools/installer.cjs",
    "deploy:check": "node tools/deploy-check.cjs",
    "todo": "node tools/project-mgmt/todo.js list",
    "todo:add": "node tools/project-mgmt/todo.js add",
    "ledger:list": "node tools/project-mgmt/ledger.js list",
    "ledger:message": "node tools/project-mgmt/ledger.js message",
    "handoff": "node tools/project-mgmt/handoff.js",
    "version:show": "node tools/project-mgmt/version-show.js",
    "version:sync": "node tools/project-mgmt/version-sync.js",
    "version:bump:patch": "node tools/project-mgmt/version-bump.js patch",
    "version:bump:minor": "node tools/project-mgmt/version-bump.js minor",
    "version:bump:major": "node tools/project-mgmt/version-bump.js major",
    "commit": "node tools/project-mgmt/commit-release.js patch",
    "commit:minor": "node tools/project-mgmt/commit-release.js minor",
    "commit:major": "node tools/project-mgmt/commit-release.js major",
    "licenses:generate": "node tools/notices.cjs",
    "capabilities:update": "node tools/update-capabilities.cjs",
    "test:packaged": "node tools/smoke.cjs --packaged"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
